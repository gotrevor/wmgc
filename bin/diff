#! /usr/bin/env nix-shell
#! nix-shell -i bash -p lftp

# Compare local files vs remote FTP server
# Shows files that differ, including orphans (drift)

set -e

if [[ "$1" == "--help" || "$1" == "-h" ]]; then
    echo "Usage: diff"
    echo ""
    echo "Compare local files vs remote FTP server."
    echo ""
    echo "Output shows:"
    echo "  📤 Would upload (new or newer locally)"
    echo "  🗑️  Remote-only (orphaned on server, not in local repo)"
    echo "  📥 Would download (newer on remote)"
    echo ""
    echo "Comparison uses file timestamps."
    exit 0
fi

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_DIR="$(dirname "$SCRIPT_DIR")"
FTP_HOST="wmgc.massgo.org"
FTP_USER="wmgcadmin"
FTP_PASS=$("$SCRIPT_DIR/wmgc-secret" get)
REMOTE_PATH="/wmgc.massgo.org"

echo "🔍 Comparing local vs remote..."
echo ""

# Excludes: files that should never be synced to server
EXCLUDES="--exclude=.git/ --exclude=bin/ --exclude=.gitignore --exclude=LICENSE --exclude=.ftpdeploy --exclude-glob=*.md --exclude=_template.html"

# Full sync check: local → remote (upload + delete orphans)
UPLOAD_OUTPUT=$(lftp -u "$FTP_USER","$FTP_PASS" "$FTP_HOST" <<EOF 2>&1 | sed "s/$FTP_PASS/****/g"
mirror --dry-run --reverse --delete $EXCLUDES "$REPO_DIR" "$REMOTE_PATH"
quit
EOF
)

if [[ "$1" == "-v" || "$1" == "--verbose" ]]; then
    echo "Raw mirror output:"
    echo "---"
    echo "$UPLOAD_OUTPUT"
    echo "---"
    echo ""
fi

echo "📤 Would UPLOAD (local → remote):"
echo "---"
echo "$UPLOAD_OUTPUT" | grep -E "^(get |mkdir )" | grep -v "^chmod" || echo "  (nothing)"

echo ""
echo "🗑️  Remote-only (drift):"
echo "---"
echo "$UPLOAD_OUTPUT" | grep -E "^rm " || echo "  (nothing)"

echo ""
echo "📥 Would DOWNLOAD (remote newer):"
echo "---"
lftp -u "$FTP_USER","$FTP_PASS" "$FTP_HOST" <<EOF 2>&1 | sed "s/$FTP_PASS/****/g" | grep -E "^(get |mkdir )" | grep -v "^chmod" || echo "  (nothing)"
mirror --dry-run --only-newer "$REMOTE_PATH" "$REPO_DIR"
quit
EOF

echo ""
echo "✅ Diff complete"
